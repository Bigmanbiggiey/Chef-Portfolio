# Netlify Function / SMTP (server-only, no VITE_ prefix)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=your Gmail address, SMTP_PASS=a 16-character Gmail App Password
# (requires 2-Step Verification enabled on the Google account — App Passwords
# don't work with a regular account password).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Supabase (client-bundled by Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase service_role key (server-only, no VITE_ prefix — NEVER expose this
# to the client, it bypasses Row Level Security entirely). Used only by
# netlify/functions/contact.js to log inquiries. Find it in Supabase under
# Project Settings -> API -> service_role (the "secret" key, not "anon").
SUPABASE_SERVICE_ROLE_KEY=
